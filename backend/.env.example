# Copy to .env and adjust. Never commit the real .env.
FLASK_APP=wsgi.py
FLASK_DEBUG=1

# Secrets: generate with  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-too

# Database: SQLite by default (zero setup). For PostgreSQL:
# DATABASE_URL=postgresql://fuelgo:fuelgo@localhost:5432/fuelgo
DATABASE_URL=sqlite:///fuelgo.db

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Payments: "mock" (offline sandbox) or "razorpay" (test mode, needs keys + `pip install razorpay`)
PAYMENT_GATEWAY=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Allow the demo tracking simulator endpoint
SIMULATOR_ENABLED=1

# Rate limit for auth endpoints
AUTH_RATE_LIMIT=20 per minute
