{
  "appId": "in.fuelgo.app",
  "appName": "FuelGo",
  "webDir": "dist",
  "server": {
    "androidScheme": "http",
    "cleartext": true
  },
  "android": {
    "allowMixedContent": true
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "launchAutoHide": true,
      "backgroundColor": "#0f1f3d",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    },
    "StatusBar": {
      "backgroundColor": "#0f1f3d",
      "style": "DARK",
      "overlaysWebView": false
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_fuelgo",
      "iconColor": "#f59e0b"
    }
  }
}
