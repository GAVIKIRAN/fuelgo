{
  "name": "fuelgo-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "android:sync": "vite build --mode android && cap sync android",
    "android:build": "node scripts/build-android.mjs",
    "android:release": "node scripts/build-android.mjs release",
    "android:open": "cap open android",
    "android:assets": "node scripts/make-app-assets.mjs && capacitor-assets generate --android --iconBackgroundColor #0f1f3d --splashBackgroundColor #0f1f3d --splashBackgroundColorDark #0a1222"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@vitejs/plugin-react": "^6.2.1",
    "jsdom": "^31.0.0",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/geolocation": "^8.2.4",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "axios": "^1.21.0",
    "leaflet": "^1.9.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hot-toast": "^2.6.1",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.10.1",
    "socket.io-client": "^4.8.4"
  }
}
